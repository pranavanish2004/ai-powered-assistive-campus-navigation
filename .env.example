# Copy this file to .env and adjust values for your machine.
# See src/campus_nav/config/settings.py for full documentation of each field.

APP_ENV=development
APP_NAME=campus-nav-assistant

LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FORMAT=text

DATABASE_URL=sqlite:///./data/campus_nav.db

CAMERA_INDEX=0
CAMERA_FRAME_WIDTH=640
CAMERA_FRAME_HEIGHT=480

GPS_PROVIDER=mock
GPS_SNAP_MAX_DISTANCE_METERS=30.0

WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE=en

TTS_ENGINE=pyttsx3
TTS_RATE_WPM=175

MIN_DETECTION_CONFIDENCE=0.5
OFF_ROUTE_WARNING_METERS=15.0

# --- Phase 1.3: Vision Pipeline ---
CAMERA_SOURCE_TYPE=usb
CAMERA_IP_URL=
CAMERA_VIDEO_FILE_PATH=
CAMERA_LOOP_VIDEO_FILE=true
FRAME_BUFFER_SIZE=5
VISION_PROCESSING_FPS=5.0

DETECTOR_BACKEND=mock
YOLO_MODEL_PATH=yolov8n.pt

OCR_BACKEND=mock
OCR_CONFIDENCE_THRESHOLD=0.4

DEPTH_BACKEND=heuristic
DEPTH_SAFE_DISTANCE_METERS=1.5

TRACKING_IOU_THRESHOLD=0.3
TRACKING_MAX_MISSED_FRAMES=10
